<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Typography Lab</title>
<style>
/* Typography Lab, 9 November 2026. All values live in CSS custom properties; the panel only writes them. */
/* FR : toutes les valeurs vivent dans des variables CSS ; le panneau ne fait que les écrire. */
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:100 450;font-style:normal;font-display:block}
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:451 599;font-style:normal;font-display:block}
@font-face{font-family:'Adobe Clean';src:url(data:font/woff2;base64,) format('woff2');font-weight:600 900;font-style:normal;font-display:block}
@font-face{font-family:'GT Ultra';src:url(data:font/woff2;base64,) format('woff2');font-weight:100 900;font-style:normal;font-display:block}
@font-face{font-family:'Literata';src:url(data:font/woff2;base64,) format('woff2');font-weight:200 900;font-style:normal;font-display:block}
@font-face{font-family:'Literata';src:url(data:font/woff2;base64,) format('woff2');font-weight:200 900;font-style:italic;font-display:block}
@font-face{font-family:'AnthropicMono';src:url(data:font/ttf;base64,) format('truetype');font-weight:400;font-style:normal;font-display:block}
:root{
  --bg:#f6f5f2;--panel:#ffffff;--ink:#1c1b19;--muted:#6b6862;--line:#dedbd4;--accent:#cc7c5e;--chip:#ecebe6;--sample:#ffffff;
  --gutter:16px;--ease:.2s;
}
:root[data-theme="dark"]{--bg:#141413;--panel:#1d1c1a;--ink:#ecebe6;--muted:#9a978f;--line:#33312d;--accent:#e08f70;--chip:#2a2825;--sample:#1d1c1a}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141413;--panel:#1d1c1a;--ink:#ecebe6;--muted:#9a978f;--line:#33312d;--accent:#e08f70;--chip:#2a2825;--sample:#1d1c1a}}
*{box-sizing:border-box}
html{font-synthesis:none}
body{margin:0;background:var(--bg);color:var(--ink);font:400 14px/1.45 'Adobe Clean',system-ui,sans-serif;transition:background var(--ease),color var(--ease)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
.wrap{max-width:1500px;margin:0 auto;padding:var(--gutter)}
header.top{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;margin-bottom:12px}
header.top h1{font:500 22px/1.2 'Adobe Clean',sans-serif;margin:0}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
button,select,input{font:inherit;color:inherit}
.btn,.chip{border:1px solid var(--line);background:var(--chip);border-radius:999px;padding:6px 12px;cursor:pointer;transition:background var(--ease),border-color var(--ease)}
.btn:hover,.chip:hover{border-color:var(--accent)}
.chip[aria-pressed="true"],.btn.on{background:var(--accent);border-color:var(--accent);color:#fff}
.tag{font-size:11px;color:var(--muted);margin-left:4px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:14px;transition:background var(--ease)}
.panel h2{font:500 13px/1.2 'Adobe Clean',sans-serif;margin:0 0 8px;color:var(--muted);text-transform:none}
.presets{display:flex;flex-wrap:wrap;gap:8px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(310px,100%),1fr));gap:8px 18px}
.role{display:grid;grid-template-columns:96px minmax(0,1fr) 74px;gap:6px 8px;align-items:center;padding:6px 0;border-bottom:1px dashed var(--line)}
.role label.n{font-weight:500}
.role select{width:100%;min-width:0;background:var(--chip);border:1px solid var(--line);border-radius:8px;padding:4px 6px}
.role .row2{grid-column:2 / 4;display:grid;grid-template-columns:1fr 54px;gap:8px;align-items:center}
.role input[type=range]{width:100%;accent-color:var(--accent)}
.role input[type=number]{width:54px;background:var(--chip);border:1px solid var(--line);border-radius:8px;padding:3px 4px}
.cols>*{min-width:0}
.cols{display:grid;gap:14px;grid-template-columns:repeat(var(--cols,1),minmax(0,1fr))}
@media (max-width:900px){.cols{grid-template-columns:1fr}}
.colhead{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-bottom:6px}
.colhead select{min-width:0;background:var(--chip);border:1px solid var(--line);border-radius:8px;padding:4px 6px;max-width:100%}
.colhead .sel{font-size:12px;color:var(--muted);cursor:pointer}
.col.selected .sample{outline:2px solid var(--accent)}
/* The sample reads only the per-column role variables. / L'échantillon ne lit que les variables de rôle de sa colonne. */
.sample{background:var(--sample);border:1px solid var(--line);border-radius:14px;padding:24px;overflow:hidden;transition:background var(--ease)}
.sample h1{font-family:var(--h1-fam);font-weight:var(--h1-w);font-size:calc(var(--h1-s)*1px);line-height:1.12;margin:0 0 14px}
.sample h2{font-family:var(--h2-fam);font-weight:var(--h2-w);font-size:calc(var(--h2-s)*1px);line-height:1.2;margin:22px 0 8px}
.sample h3{font-family:var(--h2-fam);font-weight:var(--h2-w);font-size:calc(var(--h2-s)*.8px);line-height:1.25;margin:16px 0 6px}
.sample p{font-family:var(--body-fam);font-weight:var(--body-w);font-size:calc(var(--body-s)*1px);line-height:1.55;margin:0 0 10px;max-width:68ch}
.sample em{font-style:italic}
.n{font-family:var(--num-fam);font-weight:var(--num-w);font-size:calc(1em*var(--num-s));font-style:normal}
.ui{font-family:var(--ui-fam);font-weight:var(--ui-w);font-size:calc(var(--ui-s)*1px)}
.sample .btns{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.sample .b{border:1px solid var(--line);background:var(--chip);border-radius:999px;padding:6px 14px;font-family:var(--ui-fam);font-weight:var(--ui-w);font-size:calc(var(--ui-s)*1px);color:var(--ink)}
.sample .b.p{background:var(--accent);border-color:var(--accent);color:#fff}
.sample .c{display:inline-block;border-radius:8px;background:var(--chip);padding:2px 9px;font-family:var(--ui-fam);font-weight:var(--ui-w);font-size:calc(var(--ui-s)*.86px)}
.sample table{border-collapse:collapse;width:100%;margin:10px 0;font-family:var(--body-fam);font-size:calc(var(--body-s)*.94px)}
.sample th{font-family:var(--ui-fam);font-weight:var(--ui-w);font-size:calc(var(--ui-s)*1px);text-align:left;color:var(--muted);border-bottom:1px solid var(--line);padding:6px 8px 6px 0}
.sample td{padding:6px 8px 6px 0;border-bottom:1px solid var(--line);font-weight:var(--body-w)}
.sample td.r,.sample th.r{text-align:right}
.sample figure{margin:14px 0}
.sample figcaption{font-family:var(--cap-fam);font-weight:var(--cap-w);font-size:calc(var(--cap-s)*1px);color:var(--muted);margin-top:4px}
.svgwrap{overflow-x:auto}
.sample svg{width:100%;min-width:620px;max-width:780px;height:auto;display:block}
.sample svg text{fill:var(--ink);font-family:var(--svg-fam);font-weight:var(--svg-w);font-size:calc(var(--svg-s)*1px)}
.sample svg text.sm{font-size:calc(var(--svg-s)*.82px);fill:var(--muted)}
.sample svg .box{fill:var(--chip);stroke:var(--line)}
.sample svg .dash{fill:none;stroke:var(--muted);stroke-dasharray:5 4}
.sample svg .arrow{stroke:var(--accent);stroke-width:2;fill:none}
.sample code{font-family:'AnthropicMono',ui-monospace,monospace;font-size:calc(var(--code-s)*1px);background:var(--chip);border-radius:6px;padding:2px 6px}
.sample pre{margin:8px 0;font-family:'AnthropicMono',ui-monospace,monospace;font-size:calc(var(--code-s)*1px);background:var(--chip);border-radius:8px;padding:10px;overflow-x:auto}
.toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:8px 14px;border-radius:999px;opacity:0;transition:opacity var(--ease);pointer-events:none;font-size:13px}
.toast.show{opacity:1}
.hint{font-size:12px;color:var(--muted);margin:4px 0 0}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <h1>Typography Lab</h1>
  <div class="bar">
    <span class="tag">Colonnes</span>
    <button class="chip" data-cols="1" aria-pressed="true">1</button>
    <button class="chip" data-cols="2" aria-pressed="false">2</button>
    <button class="chip" data-cols="3" aria-pressed="false">3</button>
    <button class="btn" id="theme">Thème clair / sombre</button>
    <button class="btn" id="copy">Copier les valeurs pour le prompt</button>
  </div>
</header>

<section class="panel">
  <h2>Préréglages (appliqués à la colonne sélectionnée)</h2>
  <div class="presets" id="presets"></div>
  <p class="hint" id="presetHint"></p>
</section>

<section class="panel">
  <h2>Rôles de la colonne sélectionnée : <span id="selName"></span></h2>
  <div class="grid" id="roles"></div>
</section>

<div class="cols" id="cols"></div>
</div>
<div class="toast" id="toast"></div>

<script>
/* Typography Lab logic, 9 November 2026. State = one config object per column; the panel writes CSS variables on the column. */
const FAMILIES = {
  'Adobe Clean': "'Adobe Clean','Hiragino Sans W4',sans-serif",
  'GT Ultra': "'GT Ultra','Hiragino Sans W4',sans-serif",
  'Literata': "'Literata','Hiragino Mincho ProN W3',Georgia,serif",
  'AnthropicMono': "'AnthropicMono',ui-monospace,monospace"
};
const WEIGHTS = [400, 500, 600, 700];
const ROLES = [
  { id: 'h1',   label: 'Titre h1',        size: [20, 72, 40], unit: 'px' },
  { id: 'h2',   label: 'Titres h2/h3',    size: [14, 48, 24], unit: 'px' },
  { id: 'body', label: 'Corps',           size: [12, 28, 16], unit: 'px' },
  { id: 'num',  label: 'Nombres, dates',  size: [70, 130, 100], unit: '%' },
  { id: 'ui',   label: 'Interface',       size: [10, 22, 14], unit: 'px' },
  { id: 'svg',  label: 'Schéma SVG',      size: [9, 22, 13], unit: 'px' },
  { id: 'cap',  label: 'Légendes',        size: [9, 20, 12], unit: 'px' },
  { id: 'code', label: 'Code',            size: [10, 20, 13], unit: 'px' }
];
// A preset gives a family per role; weights stay sober by default. / Un préréglage donne une famille par rôle ; graisses sobres.
const mk = (f) => ({ h1: f.h1, h2: f.h2 ?? f.h1, body: f.body, num: f.num, ui: f.ui, svg: f.svg ?? f.ui, cap: f.cap ?? f.ui, code: 'AnthropicMono' });
const PRESETS = {
  A: { name: 'A · Trio GT Ultra, Adobe Clean, Literata', fam: mk({ h1: 'GT Ultra', body: 'Literata', num: 'GT Ultra', ui: 'Adobe Clean' }) },
  B: { name: 'B · Tout Adobe Clean (défaut actuel)', fam: mk({ h1: 'Adobe Clean', body: 'Adobe Clean', num: 'Adobe Clean', ui: 'Adobe Clean' }), current: true },
  C: { name: 'C · Tout GT Ultra', fam: mk({ h1: 'GT Ultra', body: 'GT Ultra', num: 'GT Ultra', ui: 'GT Ultra' }) },
  D: { name: 'D · Tout Literata', fam: mk({ h1: 'Literata', body: 'Literata', num: 'Literata', ui: 'Literata' }) },
  E: { name: 'E · Adobe Clean, corps Literata', fam: mk({ h1: 'Adobe Clean', body: 'Literata', num: 'Adobe Clean', ui: 'Adobe Clean' }) },
  F: { name: 'F · Adobe Clean, titres GT Ultra', fam: mk({ h1: 'GT Ultra', body: 'Adobe Clean', num: 'Adobe Clean', ui: 'Adobe Clean' }) },
  G: { name: 'G · Adobe Clean, nombres GT Ultra', fam: mk({ h1: 'Adobe Clean', body: 'Adobe Clean', num: 'GT Ultra', ui: 'Adobe Clean' }) }
};
const defaultWeight = (role, fam) => fam !== 'Adobe Clean' ? 400 : (role === 'h1' || role === 'h2' ? 500 : 400);
const fromPreset = (key) => {
  const cfg = { preset: key, roles: {} };
  for (const r of ROLES) cfg.roles[r.id] = { fam: PRESETS[key].fam[r.id], w: defaultWeight(r.id, PRESETS[key].fam[r.id]), s: r.size[2] };
  return cfg;
};
const state = { cols: 1, selected: 0, theme: null, configs: [fromPreset('B'), fromPreset('A'), fromPreset('E')] };

// Hash parameters for sharing and tests: #cols=3&p=B,A,E&theme=dark / Paramètres d'URL pour partager et tester.
try {
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.get('cols')) state.cols = Math.min(3, Math.max(1, +h.get('cols')));
  if (h.get('p')) h.get('p').split(',').forEach((k, i) => { if (PRESETS[k] && i < 3) state.configs[i] = fromPreset(k); });
  if (h.get('theme')) state.theme = h.get('theme');
} catch (e) { /* ignore */ }

const SAMPLE = `
<h1>Synthèse du projet, <span class="n">9 novembre 2026</span></h1>
<p>Ce projet transforme une image de référence en matériau procédural que l'on peut régler soi-même. Il sert à gagner du temps sur les textures répétitives, sans repartir d'une page blanche.</p>
<h2>Comment ça marche</h2>
<p>La carte de hauteur est mesurée sur <span class="n">33 583</span> points, puis recalée île par île avec une corrélation de <span class="n">0,999</span>. Chaque étape se vérifie en <span class="n">2,4 s</span> et le tout tient dans <span class="n">150</span> nœuds. Le lot du <span class="n">12 octobre 2026</span> coûte <span class="n">1 900 €</span>, soit <span class="n">20</span> parts de <span class="n">95 Mio</span>. <em>Une nuance en italique</em> pour juger le style.</p>
<h3>Résultats mesurés</h3>
<table>
  <thead><tr><th>Étape</th><th>Outil</th><th class="r">Score</th><th class="r">Durée</th></tr></thead>
  <tbody>
    <tr><td>Height</td><td>Copernicus</td><td class="r"><span class="n">0,999</span></td><td class="r"><span class="n">2,4 s</span></td></tr>
    <tr><td>Base color</td><td>Roues de couleur</td><td class="r"><span class="n">0,992</span></td><td class="r"><span class="n">1,1 s</span></td></tr>
    <tr><td>Cinq cartes</td><td>Dérivation</td><td class="r"><span class="n">0,987</span></td><td class="r"><span class="n">3,8 s</span></td></tr>
  </tbody>
</table>
<div class="btns"><button class="b p" tabindex="-1">Publier</button><button class="b" tabindex="-1">Annuler</button><span class="c">Brouillon</span><span class="c">v<span class="n">3</span></span><span class="c"><span class="n">12</span> fichiers</span></div>
<figure>
<div class="svgwrap"><svg viewBox="0 0 760 220" role="img" aria-label="Schéma de la chaîne">
  <rect class="box" x="10" y="20" width="160" height="90" rx="12"/>
  <text x="90" y="56" text-anchor="middle">Image source</text>
  <text class="sm" x="90" y="84" text-anchor="middle">entrée, <tspan class="n">1</tspan> fichier</text>
  <rect class="box" x="210" y="20" width="160" height="90" rx="12"/>
  <text x="290" y="56" text-anchor="middle">Height</text>
  <text class="sm" x="290" y="84" text-anchor="middle"><tspan class="n">0,999</tspan> en <tspan class="n">2,4 s</tspan></text>
  <rect class="box" x="410" y="20" width="160" height="90" rx="12"/>
  <text x="490" y="56" text-anchor="middle">Base color</text>
  <text class="sm" x="490" y="84" text-anchor="middle"><tspan class="n">0,992</tspan> en <tspan class="n">1,1 s</tspan></text>
  <rect class="box" x="610" y="20" width="140" height="90" rx="12"/>
  <text x="680" y="56" text-anchor="middle">Sortie</text>
  <text class="sm" x="680" y="84" text-anchor="middle"><tspan class="n">5</tspan> cartes</text>
  <path class="arrow" d="M170 65H208M370 65H408M570 65H608"/>
  <rect class="dash" x="210" y="140" width="160" height="64" rx="12"/>
  <text class="sm" x="290" y="168" text-anchor="middle">Voie écartée</text>
  <text class="sm" x="290" y="190" text-anchor="middle">score <tspan class="n">0,81</tspan></text>
  <text class="sm" x="410" y="176">12 octobre 2026, <tspan class="n">16</tspan> méthodes testées</text>
</svg></div>
<figcaption>Schéma 1 : chaîne mesurée, <span class="n">3</span> étapes retenues sur <span class="n">4</span>.</figcaption>
</figure>
<p>Commande de vérification : <code>node verify.mjs --count 33583 --json</code></p>
<pre>ratio = 0.999   # <span style="opacity:.7">measured on 33 583 points</span></pre>
`;

const $ = (s, el = document) => el.querySelector(s);
const toast = (msg) => { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 1600); };

function applyVars(el, cfg) {
  for (const r of ROLES) {
    const c = cfg.roles[r.id];
    el.style.setProperty(`--${r.id}-fam`, FAMILIES[c.fam]);
    el.style.setProperty(`--${r.id}-w`, c.w);
    el.style.setProperty(`--${r.id}-s`, r.id === 'num' ? c.s / 100 : c.s);
  }
}
function renderCols() {
  const host = $('#cols'); host.innerHTML = '';
  host.style.setProperty('--cols', state.cols);
  for (let i = 0; i < state.cols; i++) {
    const cfg = state.configs[i];
    const col = document.createElement('div');
    col.className = 'col' + (i === state.selected ? ' selected' : '');
    col.dataset.i = i;
    const options = Object.entries(PRESETS).map(([k, p]) => `<option value="${k}"${cfg.preset === k ? ' selected' : ''}>${p.name}</option>`).join('') + `<option value="custom"${cfg.preset === 'custom' ? ' selected' : ''}>Mélange libre</option>`;
    col.innerHTML = `<div class="colhead"><select aria-label="Préréglage de la colonne ${i + 1}">${options}</select><span class="sel">${i === state.selected ? 'Sélectionnée' : 'Sélectionner'}</span></div><div class="sample">${SAMPLE}</div>`;
    applyVars($('.sample', col), cfg);
    $('select', col).addEventListener('change', (e) => { if (e.target.value !== 'custom') { state.configs[i] = fromPreset(e.target.value); state.selected = i; render(); } });
    col.addEventListener('click', (e) => { if (e.target.tagName !== 'SELECT' && state.selected !== i) { state.selected = i; render(); } });
    host.appendChild(col);
  }
}
function renderPanel() {
  const cfg = state.configs[state.selected];
  $('#selName').textContent = `colonne ${state.selected + 1}` + (cfg.preset !== 'custom' ? ` (${PRESETS[cfg.preset].name})` : ' (mélange libre)');
  const host = $('#roles'); host.innerHTML = '';
  for (const r of ROLES) {
    const c = cfg.roles[r.id];
    const row = document.createElement('div'); row.className = 'role';
    const isGt = c.fam === 'GT Ultra';
    row.innerHTML = `<label class="n" style="font-family:'Adobe Clean'">${r.label}</label>
      <select data-k="fam">${Object.keys(FAMILIES).filter(f => r.id === 'code' || f !== 'AnthropicMono').map(f => `<option${f === c.fam ? ' selected' : ''}>${f}</option>`).join('')}</select>
      <select data-k="w"${isGt ? ' disabled title="GT Ultra n\'a qu\'une graisse (400)"' : ''}>${WEIGHTS.map(w => `<option value="${w}"${w === c.w ? ' selected' : ''}>${w}</option>`).join('')}</select>
      <div class="row2"><input type="range" data-k="s" min="${r.size[0]}" max="${r.size[1]}" value="${c.s}" aria-label="Taille ${r.label}"><input type="number" data-k="sn" min="${r.size[0]}" max="${r.size[1]}" value="${c.s}"></div>`;
    row.addEventListener('input', (e) => {
      const k = e.target.dataset.k; if (!k) return;
      if (k === 'fam') { c.fam = e.target.value; c.w = defaultWeight(r.id, c.fam); cfg.preset = 'custom'; render(); return; }
      if (k === 'w') { c.w = +e.target.value; cfg.preset = 'custom'; }
      if (k === 's' || k === 'sn') { c.s = +e.target.value; cfg.preset = 'custom'; row.querySelector('[data-k=s]').value = c.s; row.querySelector('[data-k=sn]').value = c.s; }
      refreshSelected(cfg);
    });
    host.appendChild(row);
  }
}
function refreshSelected(cfg) {
  const col = $(`.col[data-i="${state.selected}"]`);
  applyVars($('.sample', col), cfg);
  const sel = $('select', col); if (sel) sel.value = 'custom';
  $('#selName').textContent = `colonne ${state.selected + 1} (mélange libre)`;
}
function renderPresets() {
  const host = $('#presets'); host.innerHTML = '';
  for (const [k, p] of Object.entries(PRESETS)) {
    const b = document.createElement('button'); b.className = 'chip'; b.textContent = p.name + (p.current ? ' ★' : '');
    b.setAttribute('aria-pressed', state.configs[state.selected].preset === k);
    b.addEventListener('click', () => { state.configs[state.selected] = fromPreset(k); render(); });
    host.appendChild(b);
  }
  $('#presetHint').textContent = '★ = règle courante du 9 novembre 2026 : tout en Adobe Clean, Literata seulement si une serif s\'impose. Clique une colonne pour la sélectionner, puis règle ses rôles.';
}
function render() {
  document.querySelectorAll('[data-cols]').forEach(b => b.setAttribute('aria-pressed', +b.dataset.cols === state.cols));
  if (state.selected >= state.cols) state.selected = 0;
  renderCols(); renderPanel(); renderPresets();
}
document.querySelectorAll('[data-cols]').forEach(b => b.addEventListener('click', () => { state.cols = +b.dataset.cols; render(); }));
$('#theme').addEventListener('click', () => {
  const dark = (state.theme || (matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light')) === 'dark';
  state.theme = dark ? 'light' : 'dark'; document.documentElement.dataset.theme = state.theme;
});
function summary() {
  return state.configs.slice(0, state.cols).map((cfg, i) => `Colonne ${i + 1} (${cfg.preset === 'custom' ? 'mélange libre' : PRESETS[cfg.preset].name}) : ` + ROLES.map(r => { const c = cfg.roles[r.id]; return `${r.label} ${c.fam} ${c.w} ${c.s}${r.unit}`; }).join(' ; ')).join('\n');
}
$('#copy').addEventListener('click', async () => {
  const text = summary();
  try { await navigator.clipboard.writeText(text); toast('Valeurs copiées'); }
  catch (e) { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); toast('Valeurs copiées'); } catch (e2) { toast('Copie impossible'); } ta.remove(); }
});
if (state.theme) document.documentElement.dataset.theme = state.theme;
render();
</script>
</body>
</html>
